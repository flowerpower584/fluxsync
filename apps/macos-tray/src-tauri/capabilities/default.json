{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the menu and pair windows need: Tauri command invocation + window control.",
  "windows": ["menu", "pair", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "shell:allow-open",
    "notification:default",
    "notification:allow-notify"
  ]
}
