<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- FluxSync is menu-bar-only: never show a Dock icon or appear in
       Cmd-Tab. Tauri's own set_activation_policy(Accessory) call in
       lib.rs::run()::setup() enforces this at dev-runtime too, but
       LSUIElement here is what makes a bundled release .app an agent
       app from the moment `Info.plist` is read, before app code runs. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
